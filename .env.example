# Application Settings
APP_NAME=Bayora
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Security & Cryptography (Never Expose to Frontend)
JWT_SECRET=bayora_hackathon_super_secret_jwt_signing_key_2026_x7k9
JWT_EXPIRES_IN=8h

# PostgreSQL Database Connection
DATABASE_URL=postgres://bayora_admin:bayora_secure_password_2026@localhost:5432/bayora_db
USE_IN_MEMORY_PG=auto

# Target LLM (Local Ollama Integration)
# Use http://localhost:11434 on Windows host, or http://host.docker.internal:11434 in Docker
TARGET_LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=30000
